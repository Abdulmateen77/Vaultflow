# Claude API for names/addresses/context-based PII
ANTHROPIC_API_KEY=

# Optional Claude model override
ANTHROPIC_MODEL=claude-sonnet-4-5

# Convex logging endpoint.
# Local dev example: http://127.0.0.1:3210
# Cloud example: https://abundant-ferret-758.convex.cloud
CONVEX_URL=

# Optional Convex deployment selector used by Convex CLI.
# Example: prod:abundant-ferret-758
CONVEX_DEPLOYMENT=

# Optional public Paperclip dashboard URL used by /paperclip-ui redirect.
# Example: https://paperclip.example.com or a trycloudflare.com tunnel.
PAPERCLIP_PUBLIC_URL=

# Optional Paperclip API base/company overrides for /agent/{role} endpoints.
PAPERCLIP_API_BASE=http://127.0.0.1:3100/api
PAPERCLIP_COMPANY_ID=85168c9b-e804-4657-90e4-ac16de06d1ba
PAPERCLIP_AGENT_TIMEOUT_SECONDS=180
